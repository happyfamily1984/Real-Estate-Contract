rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 로그인한 본인의 계약서만 읽고 쓸 수 있다.
    match /users/{uid}/contracts/{contractId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'status', 'pageCount', 'thumbnail', 'memo', 'title', 'contractType',
             'analysis', 'error', 'createdAt', 'updatedAt', 'analyzedAt'])
        && request.resource.data.status in ['pending', 'processing', 'done', 'error']
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount >= 1
        && request.resource.data.pageCount <= 15
        && (!('thumbnail' in request.resource.data)
            || request.resource.data.thumbnail == null
            || (request.resource.data.thumbnail is bytes && request.resource.data.thumbnail.size() < 100000));

      // 페이지 사진 (JPEG). 문서 1개 최대 1MiB.
      match /pages/{page} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['index', 'image'])
          && request.resource.data.image is bytes
          && request.resource.data.image.size() < 1000000;
      }
    }
  }
}
