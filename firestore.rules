rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한 본인의 계약서만 읽고 쓸 수 있다.
    match /users/{uid}/contracts/{contractId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // 앱은 사진 경로/메모/상태(pending 요청)만 쓸 수 있고,
      // 분석 결과(analysis 등)는 서버(Cloud Functions)만 쓴다.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.imagePaths is list
        && request.resource.data.imagePaths.size() > 0
        && request.resource.data.imagePaths.size() <= 20
        && request.resource.data.keys().hasOnly(['status', 'imagePaths', 'memo', 'title', 'createdAt', 'updatedAt']);

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'memo', 'title', 'updatedAt'])
        && (request.resource.data.status == resource.data.status
            || (request.resource.data.status == 'pending' && resource.data.status in ['done', 'error']));
    }
  }
}
